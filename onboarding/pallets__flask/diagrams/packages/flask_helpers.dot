digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/helpers: modules and imports
Box = module. Grey = other package. Label = import count." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=flask color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask"]
	n1 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n2 [label="flask/cli" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/cli"]
	n3 [label="flask/globals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/globals"]
	n4 [label="flask/scaffold" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/scaffold"]
	n5 [label="flask/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/sessions"]
	n6 [label="flask/signals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/signals"]
	n7 [label="flask/wrappers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/wrappers"]
	n8 [label=helpers tooltip="flask.helpers"]
	n0 -> n8 [label=1 penwidth=1.1]
	n1 -> n8 [label=1 penwidth=1.1]
	n2 -> n8 [label=1 penwidth=1.1]
	n4 -> n8 [label=1 penwidth=1.1]
	n5 -> n8 [label=1 penwidth=1.1]
	n8 -> n3 [label=1 penwidth=1.1]
	n8 -> n6 [label=1 penwidth=1.1]
	n8 -> n7 [label=1 penwidth=1.1]
}
