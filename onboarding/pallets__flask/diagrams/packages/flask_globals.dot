digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/globals: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=flask color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask"]
	n1 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n2 [label="flask/cli" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/cli"]
	n3 [label="flask/ctx" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/ctx"]
	n4 [label="flask/debughelpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/debughelpers"]
	n5 [label="flask/helpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/helpers"]
	n6 [label="flask/json" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/json"]
	n7 [label="flask/scaffold" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/scaffold"]
	n8 [label="flask/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/sessions"]
	n9 [label="flask/wrappers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/wrappers"]
	n10 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n11 [label=globals tooltip="flask.globals"]
	n0 -> n11 [penwidth=1.1]
	n1 -> n11 [penwidth=1.1]
	n2 -> n11 [penwidth=1.1]
	n3 -> n11 [penwidth=1.1]
	n4 -> n11 [penwidth=1.1]
	n5 -> n11 [penwidth=1.1]
	n6 -> n11 [penwidth=1.1]
	n7 -> n11 [penwidth=1.1]
	n9 -> n11 [penwidth=1.1]
	n10 -> n11 [label=3 penwidth=1.3]
	n11 -> n1 [penwidth=1.1]
	n11 -> n3 [penwidth=1.1]
	n11 -> n8 [penwidth=1.1]
	n11 -> n9 [penwidth=1.1]
}
