digraph package {
	fontname=Helvetica fontsize=10 label="Package flask: modules and imports
Box = module. Grey = other package. Label = import count." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="examples/tutorial" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::examples/tutorial"]
	n1 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n2 [label="flask/blueprints" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/blueprints"]
	n3 [label="flask/cli" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/cli"]
	n4 [label="flask/ctx" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/ctx"]
	n5 [label="flask/globals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/globals"]
	n6 [label="flask/helpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/helpers"]
	n7 [label="flask/json" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/json"]
	n8 [label="flask/signals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/signals"]
	n9 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n10 [label=flask tooltip=flask]
	n0 -> n10 [label=4 penwidth=1.4]
	n3 -> n10 [label=1 penwidth=1.1]
	n9 -> n10 [label=3 penwidth=1.3]
	n10 -> n1 [label=1 penwidth=1.1]
	n10 -> n2 [label=1 penwidth=1.1]
	n10 -> n4 [label=1 penwidth=1.1]
	n10 -> n5 [label=1 penwidth=1.1]
	n10 -> n6 [label=1 penwidth=1.1]
	n10 -> n7 [label=1 penwidth=1.1]
	n10 -> n8 [label=1 penwidth=1.1]
	n10 -> n9 [label=2 penwidth=1.2]
}
