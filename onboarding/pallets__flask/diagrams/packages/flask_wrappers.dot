digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/wrappers: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n1 [label="flask/ctx" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/ctx"]
	n2 [label="flask/debughelpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/debughelpers"]
	n3 [label="flask/globals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/globals"]
	n4 [label="flask/helpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/helpers"]
	n5 [label="flask/json" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/json"]
	n6 [label="flask/scaffold" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/scaffold"]
	n7 [label="flask/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/sessions"]
	n8 [label="flask/typing" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/typing"]
	n9 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n10 [label=wrappers tooltip="flask.wrappers"]
	n0 -> n10 [penwidth=1.1]
	n1 -> n10 [penwidth=1.1]
	n3 -> n10 [penwidth=1.1]
	n4 -> n10 [penwidth=1.1]
	n5 -> n10 [penwidth=1.1]
