digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/sessions: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n1 [label="flask/ctx" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/ctx"]
	n2 [label="flask/globals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/globals"]
	n3 [label="flask/helpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/helpers"]
	n4 [label="flask/json" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/json"]
	n5 [label="flask/wrappers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/wrappers"]
	n6 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n7 [label=sessions tooltip="flask.sessions"]
	n0 -> n7 [penwidth=1.1]
	n1 -> n7 [penwidth=1.1]
	n2 -> n7 [penwidth=1.1]
	n6 -> n7 [penwidth=1.1]
	n7 -> n0 [penwidth=1.1]
	n7 -> n3 [penwidth=1.1]
	n7 -> n4 [penwidth=1.1]
	n7 -> n5 [penwidth=1.1]
}
