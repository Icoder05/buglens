digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/app: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=flask color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask"]
	n1 [label="flask/blueprints" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/blueprints"]
	n2 [label="flask/cli" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/cli"]
