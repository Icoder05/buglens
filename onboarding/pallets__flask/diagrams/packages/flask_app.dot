	n8 [label="flask/scaffold" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/scaffold"]
	n9 [label="flask/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/sessions"]
	n10 [label="flask/signals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/signals"]
	n11 [label="flask/typing" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/typing"]
	n12 [label="flask/wrappers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/wrappers"]
	n13 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n14 [label=app tooltip="flask.app"]
	n0 -> n14 [penwidth=1.1]
