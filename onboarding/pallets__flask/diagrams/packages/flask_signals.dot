digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/signals: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=flask color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask"]
	n1 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n2 [label="flask/ctx" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/ctx"]
	n3 [label="flask/helpers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/helpers"]
	n4 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n5 [label=signals tooltip="flask.signals"]
	n0 -> n5 [penwidth=1.1]
	n1 -> n5 [penwidth=1.1]
	n2 -> n5 [penwidth=1.1]
	n3 -> n5 [penwidth=1.1]
	n4 -> n5 [penwidth=1.1]
}
