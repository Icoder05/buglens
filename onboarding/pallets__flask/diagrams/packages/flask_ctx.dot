digraph package {
	fontname=Helvetica fontsize=10 label="Package flask/ctx: modules and imports
Box = module. Grey = other package. Label = import count." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=flask color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask"]
	n1 [label="flask/app" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/app"]
	n2 [label="flask/globals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/globals"]
	n3 [label="flask/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/sessions"]
	n4 [label="flask/signals" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/signals"]
	n5 [label="flask/typing" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/typing"]
	n6 [label="flask/wrappers" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::flask/wrappers"]
	n7 [label=ctx tooltip="flask.ctx"]
	n0 -> n7 [label=1 penwidth=1.1]
	n1 -> n7 [label=1 penwidth=1.1]
	n2 -> n7 [label=1 penwidth=1.1]
	n7 -> n1 [label=1 penwidth=1.1]
	n7 -> n2 [label=1 penwidth=1.1]
	n7 -> n3 [label=1 penwidth=1.1]
	n7 -> n4 [label=1 penwidth=1.1]
	n7 -> n5 [label=1 penwidth=1.1]
	n7 -> n6 [label=1 penwidth=1.1]
}
