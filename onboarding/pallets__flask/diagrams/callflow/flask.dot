digraph callflow {
	fontname=Helvetica fontsize=10 label="Call flow from flask.cli.<module> (static approximation)
Solid = resolved static call. Dashed = calls that static analysis could not resolve (dynamic dispatch, locals, externals)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="unresolved (21)" color="#9e9e9e" fillcolor=white fontcolor="#616161" shape=ellipse style=dashed tooltip=__unresolved__]
	n1 [label="flask.cli (module)" color="#1b3a5c" penwidth=2.5 tooltip="flask.cli.<module>"]
	n2 [label=CertParamType tooltip="flask.cli.CertParamType"]
	n3 [label=FlaskGroup tooltip="flask.cli.FlaskGroup"]
	n4 [label=SeparatedPathType tooltip="flask.cli.SeparatedPathType"]
	n5 [label=main tooltip="flask.cli.main"]
	n1 -> n0 [color="#9e9e9e" style=dashed]
	n1 -> n2
	n1 -> n3
	n1 -> n4
	n1 -> n5
	n5 -> n0 [color="#9e9e9e" style=dashed]
}
