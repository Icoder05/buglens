digraph callflow {
	fontname=Helvetica fontsize=10 label="Call flow from flask.cli.run_command (static approximation)
Solid = resolved static call. Dashed = calls that static analysis could not resolve (dynamic dispatch, locals, externals)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="unresolved (10)" color="#9e9e9e" fillcolor=white fontcolor="#616161" shape=ellipse style=dashed tooltip=__unresolved__]
	n1 [label=DispatchingApp tooltip="flask.cli.DispatchingApp"]
	n2 [label=run_command color="#1b3a5c" penwidth=2.5 tooltip="flask.cli.run_command"]
	n3 [label=show_server_banner tooltip="flask.cli.show_server_banner"]
	n4 [label=get_debug_flag tooltip="flask.helpers.get_debug_flag"]
	n5 [label=get_env tooltip="flask.helpers.get_env"]
	n2 -> n0 [color="#9e9e9e" style=dashed]
	n2 -> n1
	n2 -> n3
	n2 -> n4
	n2 -> n5
	n3 -> n0 [color="#9e9e9e" style=dashed]
	n4 -> n0 [color="#9e9e9e" style=dashed]
	n4 -> n5
	n5 -> n0 [color="#9e9e9e" style=dashed]
}
