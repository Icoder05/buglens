digraph callflow {
	fontname=Helvetica fontsize=10 label="Call flow from requests.certs.<module> (static approximation)
Solid = resolved static call. Dashed = calls that static analysis could not resolve (dynamic dispatch, locals, externals)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="unresolved (3)" color="#9e9e9e" fillcolor=white fontcolor="#616161" shape=ellipse style=dashed tooltip=__unresolved__]
	n1 [label="requests.certs (module)" color="#1b3a5c" penwidth=2.5 tooltip="requests.certs.<module>"]
	n2 [label=where tooltip="requests.certs.where"]
	n1 -> n2
	n2 -> n0 [color="#9e9e9e" style=dashed]
}
