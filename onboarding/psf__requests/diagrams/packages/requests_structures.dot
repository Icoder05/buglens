digraph package {
	fontname=Helvetica fontsize=10 label="Package requests/structures: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="requests/models" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/models"]
	n1 [label="requests/status_codes" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/status_codes"]
	n2 [label=structures tooltip="requests.structures"]
	n0 -> n2 [penwidth=1.1]
	n1 -> n2 [penwidth=1.1]
}
