digraph package {
	fontname=Helvetica fontsize=10 label="Package requests/compat: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n1 [label="requests/cookies" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/cookies"]
	n2 [label="requests/models" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/models"]
	n3 [label="requests/packages" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/packages"]
	n4 [label="requests/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/sessions"]
	n5 [label="requests/utils" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/utils"]
	n6 [label=compat tooltip="requests.compat"]
	n0 -> n6 [penwidth=1.1]
	n1 -> n6 [penwidth=1.1]
	n2 -> n6 [penwidth=1.1]
	n4 -> n6 [penwidth=1.1]
	n5 -> n6 [penwidth=1.1]
	n6 -> n3 [label=3 penwidth=1.3]
}
