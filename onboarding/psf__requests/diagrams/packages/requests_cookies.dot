digraph package {
	fontname=Helvetica fontsize=10 label="Package requests/cookies: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label="requests/compat" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/compat"]
	n1 [label="requests/models" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/models"]
	n2 [label="requests/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/sessions"]
	n3 [label="requests/utils" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/utils"]
	n4 [label=cookies tooltip="requests.cookies"]
	n1 -> n4 [penwidth=1.1]
	n2 -> n4 [penwidth=1.1]
	n3 -> n4 [penwidth=1.1]
	n4 -> n0 [penwidth=1.1]
}
