digraph package {
	fontname=Helvetica fontsize=10 label="Package requests/exceptions: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=requests color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests"]
	n1 [label="requests/models" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/models"]
	n2 [label="requests/safe_mode" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/safe_mode"]
	n3 [label=exceptions tooltip="requests.exceptions"]
	n0 -> n3 [penwidth=1.1]
	n1 -> n3 [penwidth=1.1]
	n2 -> n3 [penwidth=1.1]
}
