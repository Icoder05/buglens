digraph package {
	fontname=Helvetica fontsize=10 label="Package requests/utils: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n1 [label=requests color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests"]
	n2 [label="requests/certs" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/certs"]
	n3 [label="requests/compat" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/compat"]
	n4 [label="requests/cookies" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/cookies"]
	n5 [label="requests/defaults" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/defaults"]
	n6 [label="requests/models" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/models"]
	n7 [label="requests/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/sessions"]
	n8 [label=utils tooltip="requests.utils"]
	n0 -> n8 [penwidth=1.1]
	n1 -> n8 [penwidth=1.1]
	n5 -> n8 [penwidth=1.1]
	n6 -> n8 [penwidth=1.1]
	n7 -> n8 [penwidth=1.1]
	n8 -> n1 [penwidth=1.1]
	n8 -> n2 [penwidth=1.1]
	n8 -> n3 [penwidth=1.1]
	n8 -> n4 [penwidth=1.1]
}
