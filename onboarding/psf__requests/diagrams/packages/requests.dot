digraph package {
	fontname=Helvetica fontsize=10 label="Package requests: modules and imports
Box = module. Grey = other package. Label = import count (unlabelled = 1)." labelloc=b nodesep=0.35 rankdir=LR ranksep=0.6
	node [color="#4c6a92" fillcolor="#e8eef7" fontname=Helvetica fontsize=11 shape=box style="rounded,filled"]
	edge [arrowsize=0.7 color="#607d8b" fontname=Helvetica fontsize=9]
	n0 [label=other color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::other"]
	n1 [label="requests/exceptions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/exceptions"]
	n2 [label="requests/models" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/models"]
	n3 [label="requests/sessions" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/sessions"]
	n4 [label="requests/status_codes" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/status_codes"]
	n5 [label="requests/utils" color="#9e9e9e" fillcolor="#eeeeee" fontcolor="#616161" tooltip="ext::requests/utils"]
	n6 [label=requests tooltip=requests]
	n5 -> n6 [penwidth=1.1]
	n6 -> n0 [penwidth=1.1]
	n6 -> n1 [penwidth=1.1]
	n6 -> n2 [penwidth=1.1]
	n6 -> n3 [penwidth=1.1]
	n6 -> n4 [penwidth=1.1]
	n6 -> n5 [penwidth=1.1]
}
